# --- Supabase (required) ---
# Project Settings -> API. Use the SERVICE ROLE / secret key. Backend only, never in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=knowledge-documents

# --- Gemini (required for document ingestion and question answering) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768   # must stay 768 (matches vector(768) in the SQL migrations)
# Gemini text model used to write answers (blank = default gemini-2.5-flash).
LLM_MODEL=gemini-2.5-flash

# --- RAG retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.5   # minimum cosine similarity (0-1); raise for stricter matches

# --- Agora voice agent ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# --- Agora custom tools (REQUIRED to start a voice session) ---
# Agora's cloud calls this backend's /api/agent/tools/* routes, so it needs a PUBLIC HTTPS URL of this backend
# (a deployed URL, or a temporary HTTPS tunnel while developing). localhost / private addresses are rejected.
# Give the origin only, no trailing path and no secrets, e.g. https://your-backend.example.com
# Restart the backend after changing it, and start a NEW voice session (a running agent keeps the old URL).
AGORA_TOOLS_BASE_URL=
# Shared secret that Agora sends in the X-WorkPilot-Tool-Secret header on every tool call; the backend rejects
# tool calls without it. At least 16 visible characters, no spaces. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit the real value. While it is blank the tool routes are open (local development only).
AGORA_TOOLS_SHARED_SECRET=

MURF_API_KEY=

FRONTEND_URL=http://localhost:5173
