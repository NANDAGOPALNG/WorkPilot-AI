# --- Supabase (required) ---
# Project Settings -> API. Use the SERVICE ROLE / secret key. Backend only, never in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=knowledge-documents

# --- Gemini (required for document ingestion; also used for the LLM later) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768   # must stay 768 (matches vector(768) in the SQL migrations)
LLM_MODEL=

# --- Agora (later step) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

MURF_API_KEY=

FRONTEND_URL=http://localhost:5173
